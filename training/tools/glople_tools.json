          "gender": {"type": "string", "enum": ["남성", "여성"]},
          "mbti": {"type": "string", "description": "MBTI 4글자 대문자 (예: ENFP)"}
        },
        "required": ["age", "gender", "mbti"]
      }
    }
  },
  {
