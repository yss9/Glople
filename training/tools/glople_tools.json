[
  {
    "type": "function",
    "function": {
      "name": "recommend_by_keywords",
      "description": "여행 취향 키워드로 여행지를 추천한다. 지역을 정하지 않고 취향만 말했을 때 쓴다.",
      "parameters": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {"type": "string"},
            "description": "사용자가 말한 여행 취향 키워드 (예: 바다, 야경, 사찰)"
          }
        },
        "required": ["keywords"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_destinations",
      "description": "특정 지역(국내 시도·도시 또는 해외 국가·도시)의 관광지, 문화시설, 축제, 레포츠, 맛집, 숙소를 검색한다.",
      "parameters": {
        "type": "object",
        "properties": {
          "region": {"type": "string", "description": "사용자가 말한 지역명 그대로"},
          "category": {
            "type": "string",
            "enum": ["관광지", "문화시설", "축제", "레포츠", "음식점", "숙박"],
            "description": "찾는 장소 유형"
          },
          "query": {"type": "string", "description": "사용자가 덧붙인 조건 그대로 (예: 야경 예쁜, 아이와 가기 좋은). 없으면 생략"},
          "limit": {"type": "integer", "description": "사용자가 개수를 말했을 때만 지정"}
        },
        "required": ["region"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "recommend_similar_traveler_routes",
      "description": "나이·성별·MBTI가 비슷한 여행자들이 다녀온 여행 루트를 추천한다.",
      "parameters": {
        "type": "object",
        "properties": {
